        },
        "query": "=SELECT o.order_id, o.customer_id, o.country, o.currency, o.item, o.sku, o.size, o.amount,\n       o.status AS order_status, o.refunded, s.status AS ship_status,\n       DATEDIFF(c.asof, s.delivered_date) AS days_since_delivery,\n       p.return_window_days, p.version AS policy_version,\n       (SELECT COUNT(*) FROM returns r WHERE r.order_id = o.order_id) AS return_count,\n       (SELECT COUNT(*) FROM refunds f WHERE f.order_id = o.order_id) AS refund_count,\n       (SELECT COUNT(*) FROM exchanges e WHERE e.order_id = o.order_id AND e.status NOT IN ('rejected', 'cancelled')) AS exchange_count,\n       (SELECT pr.category FROM products pr WHERE pr.sku = o.sku) AS category,\n       (SELECT CAST(config_value AS BIGINT) FROM config WHERE config_key = 'risk_score_escalate') AS risk_score_escalate,\n       (SELECT CAST(config_value AS BIGINT) FROM config WHERE config_key = 'serial_refund_threshold') AS serial_refund_threshold\nFROM orders o\nLEFT JOIN shipments s ON s.order_id = o.order_id\nJOIN policies p ON p.country = o.country\nCROSS JOIN (SELECT CAST(config_value AS DATE) AS asof FROM config WHERE config_key = 'as_of_date') c\nWHERE o.order_id = {{ $json.order_id }}\nAND o.customer_id = {{ $json.customer_id }}",
