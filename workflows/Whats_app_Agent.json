    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst usageRecords = [];\n\nfunction findTokenUsage(obj) {\n  if (!obj || typeof obj !== 'object') return;\n\n  if (obj.tokenUsage && typeof obj.tokenUsage === 'object') {\n    const usage = obj.tokenUsage;\n\n    usageRecords.push({\n      \"Prompt Tokens\": usage.promptTokens ?? 0,\n      \"Completion Tokens\": usage.completionTokens ?? 0,\n      \"Total Tokens\": usage.totalTokens ?? 0,\n    });\n\n    return;\n  }\n\n  if (Array.isArray(obj)) {\n    for (const item of obj) {\n      findTokenUsage(item);\n    }\n  } else {\n    for (const value of Object.values(obj)) {\n      findTokenUsage(value);\n    }\n  }\n}\n\nfor (const item of items) {\n  findTokenUsage(item.json);\n}\n\nreturn [{\n  json: {\n    \"Token Usage Records\": usageRecords,\n    \"Prompt Tokens\": usageRecords.map(r => r[\"Prompt Tokens\"]),\n    \"Completion Tokens\": usageRecords.map(r => r[\"Completion Tokens\"]),\n    \"Total Tokens\": usageRecords.map(r => r[\"Total Tokens\"]),\n    \"Number of Records\": usageRecords.length,\n  }\n}];"
      },
