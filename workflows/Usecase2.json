    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nitems.forEach(item => {\n\n  const row = item.json;\n\n  Object.keys(row).forEach(key => {\n\n    if (/^\\d{2}\\/[A-Za-z]{3}\\/\\d{2}$/.test(key)) {\n\n      const hours = row[key];\n\n      if (!hours || hours === \"0\") return;\n\n      if (row.Worklog && row.Worklog.trim() !== \"\") {\n\n        output.push({\n          json: {\n            Date: key,\n            Key: row.Key || \"\",\n            Issue: row.Issue || \"\",\n            Worklog: row.Worklog,\n            Hours: hours\n          }\n        });\n\n      }\n\n    }\n\n  });\n\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
