      "id": "03ad581b-e1e9-41a4-a706-85dc6de6313c",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst currentYear = new Date().getFullYear();\n\n\n\nconst groupedByDate = {};\nconst result = [];\n\n\n\n// Month names\nconst monthNames = [\n  \"Jan\",\"Feb\",\"Mar\",\"Apr\",\"May\",\"Jun\",\n  \"Jul\",\"Aug\",\"Sep\",\"Oct\",\"Nov\",\"Dec\"\n];\n\n\n\n// Month map\nconst monthMap = {\n  Jan:1, Feb:2, Mar:3, Apr:4, May:5, Jun:6,\n  Jul:7, Aug:8, Sep:9, Oct:10, Nov:11, Dec:12\n};\n\n\n\n\n\n// Normalize date: 04/Mar/26 → 04-03-2026\nfunction normalizeDate(rawDate) {\n\n\n\n  if (!rawDate) return null;\n\n\n\n  rawDate = rawDate.trim();\n\n\n\n  const parts = rawDate.split(\"/\");\n\n\n\n  if (parts.length !== 3) return null;\n\n\n\n  let [dd, mon, yy] = parts;\n\n\n\n  const mm = monthMap[mon];\n\n\n\n  if (!mm) return null;\n\n\n\n  const yyyy = yy.length === 2 ? `20${yy}` : yy;\n\n\n\n  const finalDD = String(dd).padStart(2,\"0\");\n  const finalMM = String(mm).padStart(2,\"0\");\n\n\n\n  return `${finalDD}-${finalMM}-${yyyy}`;\n}\n\n\n\n\n\n// STEP 1 — Group records by date\nfor (const item of items) {\n\n\n\n  const rawDate = item.json.Date?.trim();\n\n\n\n  if (!rawDate) continue;\n\n\n\n  const normalized = normalizeDate(rawDate);\n\n\n\n  if (!normalized) continue;\n\n\n\n  if (!groupedByDate[normalized]) {\n    groupedByDate[normalized] = {\n      descriptions: [],\n      base: item.json\n    };\n  }\n\n\n\n  const taskDesc = item.json[\"Task Description\"]?.trim();\n\n\n\n  // 🔹 Ignore duplicate tasks for the same date\n  if (\n    taskDesc &&\n    !groupedByDate[normalized].descriptions.includes(taskDesc)\n  ) {\n    groupedByDate[normalized].descriptions.push(taskDesc);\n  }\n}\n\n\n\n\n\n// Detect month\nconst firstKey = Object.keys(groupedByDate)[0];\n\n\n\nif (!firstKey) {\n  return [];\n}\n\n\n\nconst parts = firstKey.split(\"-\");\nconst month = parseInt(parts[1],10) - 1;\nconst year = parseInt(parts[2],10);\n\n\n\n\n\n// Build month range\nconst start = new Date(year, month, 1);\nconst end = new Date(year, month + 1, 0);\n\n\n\n\n\n// STEP 2 — Generate full month dataset\nfor (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {\n\n\n\n  const dd = String(d.getDate()).padStart(2,\"0\");\n  const mm = String(d.getMonth()+1).padStart(2,\"0\");\n  const yyyy = d.getFullYear();\n\n\n\n  const key = `${dd}-${mm}-${yyyy}`;\n  const monthName = monthNames[d.getMonth()];\n\n\n\n  const day = d.getDay();\n  const isWeekend = (day === 0 || day === 6);\n\n\n\n\n\n  if (groupedByDate[key]) {\n\n\n\n    const base = groupedByDate[key].base;\n\n\n\n    let comment = base.Comments || \"\";\n\n\n\n    if (isWeekend) {\n      comment = \"Weekend\";\n    }\n\n\n\n    const numberedTasks = groupedByDate[key].descriptions\n      .map((desc,i) => `${i+1}. ${desc}`)\n      .join(\"\\n\");\n\n\n\n    result.push({\n      json: {\n        ...base,\n        Month: monthName,\n        Date: key,\n        \"Task Start Date\": key,\n        \"Task End Date\": key,\n        \"Task Description\": (isWeekend || comment === \"Holiday/Leave\")\n          ? \"\"\n          : numberedTasks,\n        Comments: comment\n      }\n    });\n\n\n\n  } \n  else {\n\n\n\n    const comment = isWeekend ? \"Weekend\" : \"Holiday/Leave\";\n\n\n\n    result.push({\n      json: {\n        Month: monthName,\n        Date: key,\n        \"Task Start Date\": key,\n        \"Task End Date\": key,\n        Environment: \"Boomi\",\n        AdminDevSupport: \"Development\",\n        \"Task Description\": \"\",\n        Complexity: \"\",\n        \"Actual Efforts(hrs)\": \"8\",\n        Status: \"\",\n        Comments: comment\n      }\n    });\n\n\n\n  }\n\n\n\n}\n\n\n\nreturn result;"
      },
