    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\n// 1. Try to get Month/Year from Headers\nconst webhookNode = $('Webhook').first();\nlet month = Number(webhookNode.json.headers?.month);\nlet year = Number(webhookNode.json.headers?.year);\n\n// 2. FALLBACK: If headers are missing, guess from the first Boomi record\nif (!month || !year) {\n  const firstDate = items[0]?.json.Date; // e.g. \"02/Feb/26\"\n  if (firstDate) {\n    const parts = firstDate.split('/');\n    const monthMap = { Jan:1, Feb:2, Mar:3, Apr:4, May:5, Jun:6, Jul:7, Aug:8, Sep:9, Oct:10, Nov:11, Dec:12 };\n    month = monthMap[parts[1]];\n    year = Number(\"20\" + parts[2]);\n  }\n}\n\n// 3. Map existing data\nconst existingDataMap = {};\nitems.forEach(item => {\n  if (item.json.Date) existingDataMap[item.json.Date] = item.json;\n});\n\n// 4. Generate the Month\nif (month && year) {\n  const daysInMonth = new Date(year, month, 0).getDate();\n\n  for (let day = 1; day <= daysInMonth; day++) {\n    const dateObj = new Date(year, month - 1, day);\n    const dd = String(day).padStart(2, '0');\n    const mmm = dateObj.toLocaleString('en-GB', { month: 'short' });\n    const yy = String(year).slice(-2);\n    const dateString = `${dd}/${mmm}/${yy}`;\n\n    const dayOfWeek = dateObj.getDay(); // 0=Sun, 6=Sat\n    const isWeekend = (dayOfWeek === 0 || dayOfWeek === 6);\n\n    if (existingDataMap[dateString]) {\n      result.push({ json: existingDataMap[dateString] });\n    } else if (isWeekend) {\n      result.push({\n        json: {\n          \"Date\": dateString,\n          \"Task Start Date\": dateString,\n          \"Task End Date\": dateString,\n          \"Environment\": \"Boomi\",\n          \"AdminDevSupport\": \"Development\",\n          \"Task Description\": \"\",\n          \"Complexity\": \"\",\n          \"Actual Efforts(hrs)\": \"8\",\n          \"Status\": \"\",\n          \"Comments\": \"Weekend\"\n        }\n      });\n    }\n  }\n}\n\nreturn result;"
      },
