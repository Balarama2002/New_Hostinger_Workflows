    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = [];\n\n// 1. Get Month/Year from Webhook headers\nconst webhookNode = $('Webhook').first();\n\nlet month = Number(webhookNode.json.headers?.month);\nlet year = Number(webhookNode.json.headers?.year);\n\n// 2. Fallback - get Month/Year from first record\nif (!month || !year) {\n\n  const firstDate = items[0]?.json.Date;\n\n  if (firstDate) {\n\n    const parts = firstDate.split('/');\n\n    const monthMap = {\n      Jan: 1,\n      Feb: 2,\n      Mar: 3,\n      Apr: 4,\n      May: 5,\n      Jun: 6,\n      Jul: 7,\n      Aug: 8,\n      Sep: 9,\n      Oct: 10,\n      Nov: 11,\n      Dec: 12\n    };\n\n    month = monthMap[parts[1]];\n    year = Number(\"20\" + parts[2]);\n  }\n}\n\n// 3. Store existing records\nconst existingDataMap = {};\n\nitems.forEach(item => {\n\n  const date = item.json.Date;\n\n  if (date) {\n    existingDataMap[date] = item.json;\n  }\n\n});\n\n// 4. Month names - fixed so locale cannot affect the result\nconst monthNames = [\n  \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n];\n\n// 5. Generate all dates\nif (month && year) {\n\n  const daysInMonth = new Date(year, month, 0).getDate();\n\n  for (let day = 1; day <= daysInMonth; day++) {\n\n    const dateObj = new Date(year, month - 1, day);\n\n    const dd = String(day).padStart(2, '0');\n    const mmm = monthNames[month - 1];\n    const yy = String(year).slice(-2);\n\n    const dateString = `${dd}/${mmm}/${yy}`;\n\n    // 0 = Sunday\n    // 6 = Saturday\n    const dayOfWeek = dateObj.getDay();\n\n    const isWeekend =\n      dayOfWeek === 0 ||\n      dayOfWeek === 6;\n\n    // ==========================================\n    // EXISTING RECORD\n    // ==========================================\n    // Keep the COMPLETE original record.\n    // Nothing is changed.\n    if (existingDataMap[dateString]) {\n\n      result.push({\n        json: existingDataMap[dateString]\n      });\n\n    }\n\n    // ==========================================\n    // MISSING WEEKEND\n    // ==========================================\n    // Only create a record if it is a weekend.\n    else if (isWeekend) {\n\n      result.push({\n        json: {\n          \"Date\": dateString,\n          \"Task Start Date\": dateString,\n          \"Task End Date\": dateString,\n          \"Environment\": \"Boomi\",\n          \"AdminDevSupport\": \"Development\",\n          \"Task Description\": \"\",\n          \"Complexity\": \"\",\n          \"Actual Efforts(hrs)\": \"8\",\n          \"Status\": \"\",\n          \"Comments\": \"Weekend\"\n        }\n      });\n\n    }\n\n  }\n}\n\nreturn result;"
      },
