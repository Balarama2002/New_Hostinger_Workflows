        "query": "=SELECT\n    p.sku,\n    p.name,\n    p.category,\n    p.color,\n    p.movement,\n    p.material,\n    p.water_resistance_m,\n    p.warranty_months,\n    p.active_discount_percent,\n    p.price_inr,\n    p.price_aed,\n    COALESCE(i.stock, 0) AS stock\nFROM workspace.agentic_support.products p\nLEFT JOIN (\n    SELECT sku, SUM(stock_quantity) AS stock\n    FROM workspace.agentic_support.inventory\n    GROUP BY sku\n) i ON i.sku = p.sku\nWHERE LOWER(p.sku) = LOWER('{{ $json.product_a }}')\n   OR LOWER(p.name) LIKE CONCAT('%', LOWER('{{ $json.product_a }}'), '%')\nORDER BY\n    CASE\n        WHEN LOWER(p.sku) = LOWER('{{ $json.product_a }}')\n          OR LOWER(p.name) = LOWER('{{ $json.product_a }}')\n        THEN 0 ELSE 1\n    END,\n    p.name\nLIMIT 5\n",
