    {
      "parameters": {
        "html": "\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Welcome to TGH HR Agent</title>\n</head>\n<body style=\"margin:0; padding:0; width:100%; font-family:Arial,Helvetica,sans-serif; background:#ffffff;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n         style=\"width:100%; border-collapse:collapse;\">\n\n    <!-- Full-width Header -->\n    <tr>\n      <td style=\"background:#ad5138; padding:28px 6%; color:#ffffff;\">\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n          <tr>\n            <td style=\"font-size:22px; font-weight:bold;\">\n              TGH HR AGENT\n            </td>\n            <td align=\"right\" style=\"font-size:12px; color:#ffe4d9;\">\n              A WARM WELCOME\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n\n    <!-- Full-width Welcome Section -->\n    <tr>\n      <td style=\"background:#fbf0eb; padding:55px 6%;\">\n        <p style=\"color:#b34e35; font-size:13px; letter-spacing:2px;\">\n          ✨ YOUR HR EXPERIENCE STARTS HERE\n        </p>\n\n        <h1 style=\"color:#293550; font-size:38px; line-height:1.2; margin:20px 0;\">\n          Hey {{ $json.body.name }},<br>\n          you're in! 👋\n        </h1>\n\n        <p style=\"color:#68758d; font-size:16px; line-height:1.8; max-width:850px;\">\n          We've got some good news! You've been successfully added to the\n          <strong>TGH HR Agent</strong> platform. Your access is active,\n          and your new HR companion is ready to help.\n        </p>\n      </td>\n    </tr>\n\n    <!-- Main Content -->\n    <tr>\n      <td style=\"padding:45px 6%; background:#ffffff;\">\n\n        <h2 style=\"color:#293550; font-size:23px;\">\n          A little help goes a long way.\n        </h2>\n\n        <p style=\"color:#68758d; font-size:16px; line-height:1.8;\">\n          From finding HR policies to getting answers to everyday workplace\n          questions, your TGH HR Agent is here to make your HR experience\n          simpler and more convenient.\n        </p>\n\n        <p style=\"color:#293550; font-size:16px; line-height:1.8;\">\n          <strong>Your registered email:</strong> {{ $json.body.username }}\n        </p>\n\n        <p style=\"margin-top:35px;\">\n          <a href=\"http://200.234.36.24:3000/\"\n             style=\"display:inline-block; background:#ad5138;\n                    color:#ffffff; text-decoration:none;\n                    padding:17px 32px; font-size:16px;\n                    font-weight:bold; border-radius:5px;\">\n            Launch TGH HR Agent →\n          </a>\n        </p>\n\n        <p style=\"color:#68758d; font-size:14px; line-height:1.7; margin-top:30px;\">\n          Click the button above to access the platform and start exploring\n          your HR assistant.\n        </p>\n\n      </td>\n    </tr>\n\n    <!-- Full-width Footer -->\n    <tr>\n      <td style=\"background:#293550; padding:28px 6%; color:#ffffff;\">\n        <p style=\"font-size:15px; margin:0 0 8px;\">\n          TGH HR Agent\n        </p>\n        <p style=\"font-size:12px; color:#d4dbea; margin:0;\">\n          Your workplace HR companion. Always here to help.\n        </p>\n      </td>\n    </tr>\n\n  </table>\n</body>\n</html>\n"
      },
