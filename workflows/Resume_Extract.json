    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.output;\n\n// Remove markdown code blocks\nconst cleaned = output\n  .replace(/```json\\s*/i, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Parse JSON\nconst parsed = JSON.parse(cleaned);\n\n// Return each candidate as a separate item\nreturn parsed.candidates.map(candidate => ({\n  json: candidate\n}));"
      },
