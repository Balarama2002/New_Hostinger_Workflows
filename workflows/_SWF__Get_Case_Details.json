        "query": "=SELECT t.external_id, t.order_id, t.last_status, date_format(t.updated_at, 'dd MMM') AS updated\nFROM workspace.agentic_support.request_tracker t\nWHERE t.customer_id = '{{ String($('When Executed by Another Workflow').first().json.customer_id).replace(/'/g, \"''\") }}'\n  AND t.kind = 'ticket'\n  AND ('{{ String($('When Executed by Another Workflow').first().json.order_id ?? '').replace(/'/g, \"''\") }}' = ''\n       OR lower(t.order_id) = lower('{{ String($('When Executed by Another Workflow').first().json.order_id ?? '').replace(/'/g, \"''\") }}'))\nORDER BY t.created_at DESC LIMIT 5",
        "queryParameters": {
          "parameters": [
